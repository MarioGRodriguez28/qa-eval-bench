{
  "name": "qa-eval-bench",
  "version": "0.1.0",
  "description": "Scores how many bugs a test suite catches, using mutation testing, so tests written by people or by AI models can be compared",
  "bin": { "qa-bench": "src/cli.js" },
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "bench": "node src/cli.js run --out results/leaderboard.md"
  },
  "engines": { "node": ">=22" },
  "keywords": ["qa", "mutation-testing", "evaluation", "test-quality"],
  "author": "Mario Rodríguez",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/MarioGRodriguez28/qa-eval-bench.git" }
}
